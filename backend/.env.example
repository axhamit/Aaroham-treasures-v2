PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/luxe_store

# Frontend URL(s) allowed by CORS (comma separated for several)
CLIENT_URL=http://localhost:3000

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES=7d

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=94910711488-v0mfuqeqft5790tlmp4jgplh02qoscm4.apps.googleusercontent.com

# Razorpay (leave empty to use the built-in demo payment in development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Delhivery Courier Integration
# Get API Token from: https://one.delhivery.com > Settings > API Setup
DELHIVERY_API_TOKEN=
DELHIVERY_CLIENT_NAME=
DELHIVERY_WAREHOUSE_NAME=
DELHIVERY_API_URL=https://track.delhivery.com/api/cmu/create.json
DELHIVERY_WAYBILL_URL=https://track.delhivery.com/waybill/api/bulk/json
DELHIVERY_TRACKING_URL=https://track.delhivery.com/api/v1/track

# First admin account created by: npm run seed
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@luxe.com
ADMIN_PASSWORD=Admin@12345
