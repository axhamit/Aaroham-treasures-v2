PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/luxe_store

# Frontend URL(s) allowed by CORS (comma separated for several)
CLIENT_URL=http://localhost:3000

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES=7d

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=94910711488-v0mfuqeqft5790tlmp4jgplh02qoscm4.apps.googleusercontent.com

# Razorpay (leave empty to use the built-in demo payment in development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Delhivery API credentials and pickup account details
DELHIVERY_API_TOKEN=
DELHIVERY_CLIENT_NAME=Aaroham
DELHIVERY_WAREHOUSE_NAME=AarohamWarehouse
DELHIVERY_BASE_URL=https://staging-express.delhivery.com
DELHIVERY_TIMEOUT_MS=15000
# Parcel defaults used when automatically creating each shipment (kg and cm)
DELHIVERY_DEFAULT_WEIGHT_KG=0.5
DELHIVERY_DEFAULT_LENGTH_CM=20
DELHIVERY_DEFAULT_BREADTH_CM=15
DELHIVERY_DEFAULT_HEIGHT_CM=10

# First admin account created by: npm run seed
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@luxe.com
ADMIN_PASSWORD=Admin@12345
